# ============================================
# 环境变量模板：复制本文件为 .env 后填写真实值
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到 git
# ============================================

# ---------- DeepSeek（对话模型） ----------
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-你的key

# DeepSeek 接口地址（一般不用改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 对话模型（一般不用改）
# DEEPSEEK_MODEL=deepseek-chat

# ---------- 硅基流动（文本向量化） ----------
# RAG 要用它把文字变成向量，在 https://cloud.siliconflow.cn 申请（有免费额度）
EMBEDDING_API_KEY=sk-你的key

# 向量化接口地址（一般不用改）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# 向量模型
# 注意：改了这个必须跑 python scripts/ingest_news.py --rebuild 重建索引
#   因为不同模型算的向量不在同一个坐标系，新旧混着比距离是错的
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- RAG 检索参数（不填用代码里的默认值） ----------

# 相似度阈值（0~1）：问题跟新闻的相似度低于它，就改用普通 AI 回答
# 实测参考（跑 tests/eval_retrieval.py 扫出来的）：0.55 是拐点，
#   正样本最低 0.5624、负样本最高 0.6141，两者有重叠，只能尽量准
# SCORE_THRESHOLD=0.55

# 一次检索几块新闻当参考资料
# TOP_K=4

# 向量库存放目录（已加 .gitignore）
# 不填 = 项目根/rag_data，代码里会算成绝对路径，不管从哪个目录启动服务都读同一个库
# 填相对路径也按"相对项目根"解析，不会因为当前工作目录不同而跑到别处去
# CHROMA_PERSIST_DIR=./rag_data

# ---------- MySQL ----------
# 本地开发用（不填则用代码里的默认：root/123456@localhost:3306/news_app）
# DATABASE_URL=mysql+aiomysql://root:密码@localhost:3306/news_app?charset=utf8mb4

# 容器部署专用：docker compose 读的是这一个（不填会直接报错拦住你）
#   必须写 host.docker.internal，不能写 localhost
#   —— localhost 在容器里指的是容器自己，连不到你电脑上的 MySQL
# DOCKER_DATABASE_URL=mysql+aiomysql://root:密码@host.docker.internal:3306/news_app?charset=utf8mb4

# ---------- Redis（缓存） ----------
# 不填则用本地默认：localhost:6379 db0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ---------- 调试开关（默认关，本地想调试再打开） ----------
# 代码里的兜底默认值是 false（安全优先）。想看报错详情/看 SQL 时在这里显式打开：
#   DEBUG=true    → 500 响应里会带上 traceback 和服务器文件路径
#   SQL_ECHO=true → 每条 SQL 都打印出来（学习时看 SQLAlchemy 生成了什么很方便）
# ⚠️ 这两个开关只影响本机；docker-compose 里已经显式写成 false，
#    所以就算这里开着，容器部署也不会把 traceback 吐给客户端。
# DEBUG=false
# SQL_ECHO=false
